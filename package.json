{
  "name": "vue-zero-ai",
  "version": "1.4.0",
  "description": "Zero-build Vue 3 router for AI-driven development",
  "main": "dist/vue-zero.js",
  "files": [
    "dist/vue-zero.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopegiver/vue-zero.git"
  },
  "homepage": "https://github.com/hopegiver/vue-zero",
  "author": "hopegiver",
  "type": "module",
  "scripts": {
    "dev": "node --watch build.js",
    "build": "node build.js",
    "test": "playwright test -c test/playwright.config.js",
    "check": "node scripts/check.mjs",
    "test:basic": "VZ_APPS=basic playwright test -c test/playwright.config.js",
    "release:check": "node scripts/verify-static.mjs && node scripts/verify-e2e.mjs",
    "prepublishOnly": "node scripts/publish-gate.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "bench:budget": "node bench/budget.mjs"
  },
  "keywords": [
    "vue",
    "router",
    "zero-build",
    "no-build"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "~1.62.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  }
}
